TYPE "UDT_FifoItem"
TITLE = Elemento de FIFO
VERSION : 0.1
//Datos que viajan con cada pieza: PartID, Destino, Valor, TEntrada. Usado por FC_Fifo v1.1.
   STRUCT
      PartID : DInt;   // Numero correlativo de la pieza
      Destino : Int;   // 0: sin clasificar, 1 = salida 1, 2 = salida 2, 3 : final
      Valor : Int;   // Valor crudo de la vision, para diagnostico
      TEntrada : Time;   // Momento de entrada a la FIFO, para calcular el transito
   END_STRUCT;

END_TYPE

TYPE "UDT_Fifo"
TITLE = Estructura de FIFO circular
VERSION : 0.1
//Buffer[0..9], índices Head/Tail/Count, memorias de flanco y diagnóstico. El tamaño del array debe coincidir con C_SIZE de FC_Fifo.
   STRUCT
      Buffer { S7_SetPoint := 'False'} : Array[0..9] of "UDT_FifoItem";   // 10 CASILLAS
      Head { ExternalWritable := 'False'} : Int;   // Indice de lectura (elemento mas antiguo-de donde sale la proxima pieza)
      Tail { ExternalWritable := 'False'} : Int;   // Indice de escritura (proxima casilla libre-donde entra la proxima pieza)
      Count { ExternalWritable := 'False'} : Int;   // Elementos guardados (saber si esta lleno o vacia)
      MaxCount { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Int;   // Ocupacion maxima historica, se borra con ResetDiag
      LastOut { S7_SetPoint := 'False'} : "UDT_FifoItem";   // Ultimo elemento extraido
      Vacio { ExternalWritable := 'False'} : "UDT_FifoItem";   // Plantilla de valores por defecto, NO escribir
      PushMem { ExternalWritable := 'False'} : Bool;   // Memoria de flanco de Push
      PopMem { ExternalWritable := 'False'} : Bool;   // Memoria de flanco de Pop
      ClearMem { ExternalWritable := 'False'} : Bool;   // Memoria de flanco de Clear
      LastError { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Word;   // Ultimo error, retenido hasta Clear
      ErrorCount { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : DInt;   // Errores acumulados,  se borra con ResetDiag
   END_STRUCT;

END_TYPE

FUNCTION "FC_Fifo" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 1.1
   VAR_INPUT 
      Push : Bool;   // orden: meter DataIn en la FIFO
      Pop : Bool;   // orden: sacar el elemento mas antiguo
      Clear : Bool;   // orden: vaciar la FIFO
      ResetDiag : Bool;   // Borra MaxCount y ErrorCount (por nivel)
      DataIn : "UDT_FifoItem";   // Dato que se mete con el Push
   END_VAR

   VAR_OUTPUT 
      DataOut : "UDT_FifoItem";   // El elemento que acaba de salir del Pop
      Peek : "UDT_FifoItem";   // El elemento que saldra en el Proximo Pop, sin sacarlo
      PushDone : Bool;   // TRUE durante 1 ciclo cuando el Push se realizo
      PopDone : Bool;   // TRUE durante 1 ciclo cuando el Pop se realizo
      Empty : Bool;   // La FIFO esta VACIA (count = 0)
      Full : Bool;   // La FIFO esta LLENA (count = C_SIZE)
      Count : Int;   // Cuantos elementos hay
      Error : Bool;   // En esta llamada se rechazo una orden
      Status : Word;   // Codigo que dice que error fue
   END_VAR

   VAR_IN_OUT 
      Fifo : "UDT_Fifo";   // La FIFO real: FifoTramo1, FifoTramo2 o FifoPrueba
   END_VAR

   VAR_TEMP 
      pushEdge : Bool;   // Flanco de Push en esta llamada
      popEdge : Bool;   // Flanco de Pop en esta llamada
      clearEdge : Bool;   // Flanco de Clear en esta llamada
      indicesOk : Bool;   // Estado si los indices son correctos
      i : Int;   // Variable para iteracion
      verificacion : Int;   // Valor calculado para verificar los indices
   END_VAR

   VAR CONSTANT 
      C_SIZE : Int := 10;   // Tamaño del array: debe coincidir con [0..9]
      ST_OK : Word := 16#0000;   // Sin Error
      ST_FULL : Word := 16#8001;   // Push rechazado: FIFO llena
      ST_EMPTY : Word := 16#8002;   // Pop rechazado: FIFO Vacia
      ST_CORRUPT : Word := 16#8003;   // Indices incoherentes: FIFO bloqueada hasta un Clear
      C_DINT_MAX : DInt := 2147483647;   // Limite de saturacion de ErrorCount
   END_VAR


BEGIN
	// =====================================================================
	// Bloque   : FC_Fifo
	// Función  : FIFO circular (Head / Tail / Count) para elementos UDT_FifoItem
	// Versión  : 1.1  -  2026-11-15  -  Junior
	//
	// Contrato de uso:
	//   - Llamar UNA vez por ciclo por cada FIFO (memorias de flanco en el UDT)
	//   - No llamar a la misma FIFO desde OB distintos (p. ej. OB1 y OB30)
	//   - DataOut solo es válido en el ciclo con PopDone = TRUE
	//   - Revisar Error / Status antes de usar Count, Empty, Full
	//   - C_SIZE debe coincidir con Array[0..C_SIZE-1] de UDT_Fifo
	//   - Clear: solo con la línea físicamente vacía
	//
	// Órdenes:
	//   Push, Pop, Clear : por flanco positivo
	//   ResetDiag        : por nivel (borra MaxCount y ErrorCount)
	//
	// Orden de ejecución: Clear -> Validación -> ResetDiag -> Pop -> Push
	//
	// Status (válido solo en el ciclo actual; el último queda en Fifo.LastError):
	//   16#0000  OK
	//   16#8001  Push rechazado: FIFO llena
	//   16#8002  Pop rechazado: FIFO vacía
	//   16#8003  Índices corruptos: FIFO bloqueada hasta Clear (estado, se repite cada ciclo)
	//   Si en un mismo ciclo el Pop falla (vacía) y el Push funciona,
	//   Status = 16#8002 y PushDone = TRUE.
	//
	// Historial:
	//   1.0  Versión inicial
	//   1.1  Clear ya no borra diagnóstico (nueva entrada ResetDiag);
	//        saturación de ErrorCount; cabecera y estilo
	// =====================================================================
	
	REGION 1_InicializarSalidas
	    // Una FC no tiene memoria: todas las salidas se escriben en CADA llamada.
	    // Se parte de "no pasó nada"; las regiones siguientes lo modifican.
	    #PushDone := FALSE;
	    #PopDone := FALSE;
	    #Error := FALSE;
	    #Status := #ST_OK;
	END_REGION
	
	REGION 2_Flancos
	    // Flanco positivo = valor actual AND NOT valor del ciclo anterior.
	    // El valor anterior se guarda en el UDT (en el DB) porque Temp
	    // no conserva su valor entre llamadas.
	    #pushEdge := #Push AND NOT #Fifo.PushMem;
	    #Fifo.PushMem := #Push;
	    
	    #popEdge := #Pop AND NOT #Fifo.PopMem;
	    #Fifo.PopMem := #Pop;
	    
	    #clearEdge := #Clear AND NOT #Fifo.ClearMem;
	    #Fifo.ClearMem := #Clear;
	END_REGION
	
	REGION 3_Clear
	    // Vacía la FIFO (operación). NO borra el diagnóstico (MaxCount,
	    // ErrorCount): así se conserva la historia después de un incidente.
	    // Va ANTES de la validación para que esta revise el estado ya limpio
	    // y no dé una falsa alarma en el ciclo de recuperación.
	    IF #clearEdge THEN
	        // En este ciclo no se mete ni se saca nada de la FIFO que se borra
	        #pushEdge := FALSE;
	        #popEdge := FALSE;
	        
	        FOR #i := 0 TO #C_SIZE - 1 DO
	            #Fifo.Buffer[#i] := #Fifo.Vacio;
	        END_FOR;
	        
	        #Fifo.Head := 0;
	        #Fifo.Tail := 0;
	        #Fifo.Count := 0;
	        #Fifo.LastOut := #Fifo.Vacio;
	        #Fifo.LastError := #ST_OK;
	    END_IF;
	END_REGION
	
	REGION 4_Validacion
	    // Protege contra índices imposibles (escritos a mano en el DB, array
	    // cambiado sin cambiar C_SIZE, errores en otra parte del programa).
	    // DETECTA y BLOQUEA; nunca repara sola: la reparación es un Clear.
	    
	    // A: rangos. Siempre asigna indicesOk.
	    #indicesOk := (#Fifo.Head >= 0) AND (#Fifo.Head < #C_SIZE)
	    AND (#Fifo.Tail >= 0) AND (#Fifo.Tail < #C_SIZE)
	    AND (#Fifo.Count >= 0) AND (#Fifo.Count <= #C_SIZE);
	    
	    // B: coherencia (desde Head, avanzar Count casillas con vuelta = Tail).
	    //    Solo con rangos válidos, para no desbordar el Int en la suma.
	    IF #indicesOk THEN
	        #verificacion := (#Fifo.Head + #Fifo.Count) MOD #C_SIZE;
	        #indicesOk := (#Fifo.Tail = #verificacion);
	    END_IF;
	    
	    // C: avisar y bloquear. No incrementa ErrorCount: la corrupción es un
	    //    ESTADO que se repite cada ciclo y lo haría crecer sin control.
	    IF NOT #indicesOk THEN
	        #Error := TRUE;
	        #Status := #ST_CORRUPT;
	        #Fifo.LastError := #ST_CORRUPT;
	        #pushEdge := FALSE;
	        #popEdge := FALSE;
	    END_IF;
	END_REGION
	
	REGION 5_ResetDiag
	    // Por nivel: repetir el borrado varios ciclos no cambia el resultado.
	    // MaxCount se iguala a la ocupación actual (no a 0): el máximo desde
	    // el reset nunca puede ser menor que lo que hay ahora en la FIFO.
	    IF #ResetDiag THEN
	        #Fifo.ErrorCount := 0;
	        IF #indicesOk THEN
	            #Fifo.MaxCount := #Fifo.Count;
	        ELSE
	            #Fifo.MaxCount := 0;
	        END_IF;
	    END_IF;
	END_REGION
	
	REGION 6_Pop
	    // Va ANTES del Push: con la FIFO llena y Push + Pop en el mismo ciclo,
	    // primero se libera una casilla; con la FIFO vacía, el error queda
	    // visible en vez de entregar a una caja los datos de otra.
	    IF #popEdge THEN
	        IF #Fifo.Count > 0 THEN
	            #Fifo.LastOut := #Fifo.Buffer[#Fifo.Head];      // leer la más antigua
	            #Fifo.Buffer[#Fifo.Head] := #Fifo.Vacio;         // limpiar la casilla
	            
	            #Fifo.Head := #Fifo.Head + 1;                    // avanzar lectura
	            IF #Fifo.Head >= #C_SIZE THEN                    // vuelta circular
	                #Fifo.Head := 0;
	            END_IF;
	            
	            #Fifo.Count := #Fifo.Count - 1;
	            #PopDone := TRUE;
	        ELSE
	            // FIFO vacía: en el proceso, una caja llegó sin datos (desfase)
	            #Error := TRUE;
	            #Status := #ST_EMPTY;
	            #Fifo.LastError := #ST_EMPTY;
	            IF #Fifo.ErrorCount < #C_DINT_MAX THEN
	                #Fifo.ErrorCount := #Fifo.ErrorCount + 1;
	            END_IF;
	        END_IF;
	    END_IF;
	END_REGION
	
	REGION 7_Push
	    IF #pushEdge THEN
	        IF #Fifo.Count < #C_SIZE THEN
	            #Fifo.Buffer[#Fifo.Tail] := #DataIn;            // escribir en la libre
	            
	            #Fifo.Tail := #Fifo.Tail + 1;                    // avanzar escritura
	            IF #Fifo.Tail >= #C_SIZE THEN                    // vuelta circular
	                #Fifo.Tail := 0;
	            END_IF;
	            
	            #Fifo.Count := #Fifo.Count + 1;
	            IF #Fifo.Count > #Fifo.MaxCount THEN             // récord de ocupación
	                #Fifo.MaxCount := #Fifo.Count;
	            END_IF;
	            
	            #PushDone := TRUE;
	        ELSE
	            // FIFO llena: el dato se pierde. En el proceso significa más cajas
	            // en el tramo de las físicamente posibles (atasco o cajas sin registrar)
	            #Error := TRUE;
	            #Status := #ST_FULL;
	            #Fifo.LastError := #ST_FULL;
	            IF #Fifo.ErrorCount < #C_DINT_MAX THEN
	                #Fifo.ErrorCount := #Fifo.ErrorCount + 1;
	            END_IF;
	        END_IF;
	    END_IF;
	END_REGION
	
	REGION 8_Salidas
	    // Con la FIFO corrupta, Count / Empty / Full reflejan valores no
	    // fiables: quien llama debe revisar Error primero (ver contrato).
	    #Count := #Fifo.Count;
	    #Empty := (#Fifo.Count = 0);
	    #Full := (#Fifo.Count >= #C_SIZE);
	    #DataOut := #Fifo.LastOut;
	    
	    // Peek: la próxima en salir. indicesOk evita leer fuera del array
	    IF (#Fifo.Count > 0) AND #indicesOk THEN
	        #Peek := #Fifo.Buffer[#Fifo.Head];
	    ELSE
	        #Peek := #Fifo.Vacio;
	    END_IF;
	END_REGION
END_FUNCTION

